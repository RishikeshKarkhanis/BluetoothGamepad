package com.bluetoothgamepad

import android.Manifest
import android.app.Activity
import android.bluetooth.*
import android.content.pm.PackageManager
import android.os.Build
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.view.Gravity
import android.view.MotionEvent
import android.view.View
import android.widget.Button
import android.widget.LinearLayout
import android.widget.TextView
import java.util.concurrent.Executors

class MainActivity : Activity() {

    private lateinit var status: TextView
    private lateinit var registerButton: Button

    private var hid: BluetoothHidDevice? = null
    private var connectedDevice: BluetoothDevice? = null
    private var registered = false
    private var connecting = false

    private var buttons = 0
    private var xAxis = 0
    private var yAxis = 0

    private val handler = Handler(Looper.getMainLooper())
    private val executor = Executors.newSingleThreadExecutor()

    // Report ID 1: 16 buttons + X, Y, Rx, Ry.
    private val descriptor = byteArrayOf(
        0x05, 0x01,
        0x09, 0x05,
        0xA1.toByte(), 0x01,
        0x85.toByte(), 0x01,

        0x05, 0x09,
        0x19, 0x01,
        0x29, 0x10,
        0x15, 0x00,
        0x25, 0x01,
        0x95.toByte(), 0x10,
        0x75, 0x01,
        0x81.toByte(), 0x02,

        0x05, 0x01,
        0x09, 0x30,
        0x09, 0x31,
        0x09, 0x33,
        0x09, 0x34,
        0x15, 0x81.toByte(),
        0x25, 0x7F,
        0x75, 0x08,
        0x95.toByte(), 0x04,
        0x81.toByte(), 0x02,

        0xC0.toByte()
    )

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            gravity = Gravity.CENTER_HORIZONTAL
            setPadding(16, 24, 16, 20)
        }

        status = TextView(this).apply {
            textSize = 16f
            text = "Bluetooth Gamepad\nNot registered"
            gravity = Gravity.CENTER
            setPadding(8, 8, 8, 16)
        }

        registerButton = Button(this).apply {
            text = "Register Gamepad"
            setOnClickListener { connectHid() }
        }

        root.addView(status)
        root.addView(registerButton)

        val spacer = View(this)
        root.addView(
            spacer,
            LinearLayout.LayoutParams(1, 20)
        )

        val dpad = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            gravity = Gravity.CENTER
        }

        dpad.addView(makeButton("▲", 5))
        val middle = LinearLayout(this).apply {
            gravity = Gravity.CENTER
        }
        middle.addView(makeButton("◀", 7))
        middle.addView(makeButton("▼", 6))
        middle.addView(makeButton("▶", 8))
        dpad.addView(middle)
        root.addView(dpad)

        val gap = View(this)
        root.addView(gap, LinearLayout.LayoutParams(1, 24))

        val faceButtons = LinearLayout(this).apply {
            gravity = Gravity.CENTER
        }
        faceButtons.addView(makeButton("Y", 4))
        faceButtons.addView(makeButton("X", 3))
        faceButtons.addView(makeButton("B", 2))
        faceButtons.addView(makeButton("A", 1))
        root.addView(faceButtons)

        val menuButtons = LinearLayout(this).apply {
            gravity = Gravity.CENTER
        }
        menuButtons.addView(makeButton("SELECT", 9))
        menuButtons.addView(makeButton("START", 10))
        root.addView(menuButtons)

        setContentView(root)
    }

    private fun makeButton(label: String, buttonNumber: Int): Button {
        return Button(this).apply {
            text = label
            textSize = 14f
            isAllCaps = false

            setOnTouchListener { view, event ->
                when (event.actionMasked) {
                    MotionEvent.ACTION_DOWN -> {
                        setButton(buttonNumber, true)
                        view.isPressed = true
                        true
                    }

                    MotionEvent.ACTION_UP,
                    MotionEvent.ACTION_CANCEL -> {
                        setButton(buttonNumber, false)
                        view.isPressed = false
                        true
                    }

                    else -> true
                }
            }
        }
    }

    private fun setButton(number: Int, pressed: Boolean) {
        val mask = 1 shl (number - 1)

        buttons = if (pressed) {
            buttons or mask
        } else {
            buttons and mask.inv()
        }

        sendInputReport()
    }

    private fun sendInputReport() {
        val device = connectedDevice ?: return
        val service = hid ?: return
        if (!registered) return

        // Two bytes for 16 buttons, followed by four signed axes.
        val report = byteArrayOf(
            (buttons and 0xFF).toByte(),
            ((buttons shr 8) and 0xFF).toByte(),
            xAxis.toByte(),
            yAxis.toByte(),
            0,
            0
        )

        try {
            val sent = service.sendReport(device, 1, report)

            if (!sent) {
                status.text = "Report not sent. Check HID connection."
            }
        } catch (e: SecurityException) {
            status.text = "Bluetooth permission error: ${e.message}"
        } catch (e: Exception) {
            status.text = "Input error: ${e.message}"
        }
    }

    private fun connectHid() {
        if (connecting || registered) return

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            val permissions = arrayOf(
                Manifest.permission.BLUETOOTH_CONNECT,
                Manifest.permission.BLUETOOTH_ADVERTISE
            )

            val missing = permissions.filter {
                checkSelfPermission(it) != PackageManager.PERMISSION_GRANTED
            }

            if (missing.isNotEmpty()) {
                requestPermissions(missing.toTypedArray(), 100)
                status.text = "Grant permissions, then tap Register Gamepad."
                return
            }
        }

        try {
            val manager = getSystemService(BLUETOOTH_SERVICE) as BluetoothManager
            val adapter = manager.adapter

            if (adapter == null || !adapter.isEnabled) {
                status.text = "Enable Bluetooth first."
                return
            }

            connecting = true
            registerButton.isEnabled = false
            status.text = "Connecting to HID service..."

            val accepted = adapter.getProfileProxy(
                this,
                object : BluetoothProfile.ServiceListener {
                    override fun onServiceConnected(
                        profile: Int,
                        proxy: BluetoothProfile
                    ) {
                        if (
                            profile != BluetoothProfile.HID_DEVICE ||
                            proxy !is BluetoothHidDevice
                        ) {
                            connecting = false
                            registerButton.isEnabled = true
                            status.text = "HID Device profile unavailable."
                            return
                        }

                        hid = proxy
                        registerGamepad()
                    }

                    override fun onServiceDisconnected(profile: Int) {
                        hid = null
                        connectedDevice = null
                        registered = false
                        connecting = false

                        handler.post {
                            registerButton.isEnabled = true
                            status.text = "HID service disconnected."
                        }
                    }
                },
                BluetoothProfile.HID_DEVICE
            )

            if (!accepted) {
                connecting = false
                registerButton.isEnabled = true
                status.text = "Could not open HID service."
            }
        } catch (e: Exception) {
            connecting = false
            registerButton.isEnabled = true
            status.text = "Bluetooth error: ${e.message}"
        }
    }

    private fun registerGamepad() {
        val service = hid ?: return

        try {
            val sdp = BluetoothHidDeviceAppSdpSettings(
                "Bluetooth Gamepad",
                "Bluetooth gamepad for Mac",
                "Gamepad",
                0x08,
                descriptor
            )

            val callback = object : BluetoothHidDevice.Callback() {
                override fun onAppStatusChanged(
                    pluggedDevice: BluetoothDevice?,
                    registeredNow: Boolean
                ) {
                    registered = registeredNow
                    connecting = false

                    handler.post {
                        registerButton.isEnabled = !registeredNow
                        status.text = if (registeredNow) {
                            "Gamepad registered.\nConnect from Mac Bluetooth settings."
                        } else {
                            "Registration stopped. Another HID app may be active."
                        }
                    }

                    if (registeredNow && pluggedDevice != null) {
                        connectedDevice = pluggedDevice
                    }
                }

                override fun onConnectionStateChanged(
                    device: BluetoothDevice?,
                    state: Int
                ) {
                    handler.post {
                        when (state) {
                            BluetoothProfile.STATE_CONNECTED -> {
                                connectedDevice = device
                                status.text = "Mac connected!\nTap the gamepad buttons."
                                sendInputReport()
                            }

                            BluetoothProfile.STATE_CONNECTING -> {
                                status.text = "Connecting to Mac..."
                            }

                            BluetoothProfile.STATE_DISCONNECTED -> {
                                if (connectedDevice == device) {
                                    connectedDevice = null
                                }
                                status.text = if (registered) {
                                    "Registered. Waiting for Mac..."
                                } else {
                                    "Disconnected."
                                }
                            }
                        }
                    }
                }
            }

            val accepted = service.registerApp(
                sdp,
                null,
                null,
                executor,
                callback
            )

            if (accepted) {
                status.text = "Registration requested. Waiting for Android..."
            } else {
                connecting = false
                registerButton.isEnabled = true
                status.text = "Registration rejected. Another HID app may be active."
            }
        } catch (e: Exception) {
            connecting = false
            registerButton.isEnabled = true
            status.text = "Registration error: ${e.message}"
        }
    }

    override fun onDestroy() {
        try {
            hid?.let {
                (getSystemService(BLUETOOTH_SERVICE) as BluetoothManager)
                    .adapter?.closeProfileProxy(
                        BluetoothProfile.HID_DEVICE,
                        it
                    )
            }
        } catch (_: Exception) {
        }

        executor.shutdown()
        super.onDestroy()
    }
}
